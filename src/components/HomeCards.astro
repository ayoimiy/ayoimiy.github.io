---
import { getCollection } from 'astro:content';
import HomeCard from './HomeCard.astro';

const entries = (await getCollection('docs')).filter(
  (entry) => entry.data.status !== 'draft' && entry.id && entry.id !== '404',
);
const countIn = (prefix: string) =>
  entries.filter((entry) => entry.id === prefix.replace(/\/$/, '') || entry.id.startsWith(prefix)).length;

const modding = countIn('modding/');
const research = countIn('research/');
const reference = countIn('reference/');

const entriesLabel = (count: number) => `${count} ${count === 1 ? 'ENTRY' : 'ENTRIES'}`;
const referenceMeta = reference > 0 ? `${entriesLabel(reference)} / 建设中` : 'INDEX BUILDING';
---

<div class="home-card-grid">
  <HomeCard
    index="01"
    eyebrow="MODDING"
    title="Mod 制作"
    description="目录结构、mod.xml、Lua 钩子、调试方法与兼容性习惯。把第一个能跑起来的 Mod 搭出来。"
    href="/modding/getting-started/"
    meta={`${entriesLabel(modding)} / 持续更新`}
    icon="book"
  />
  <HomeCard
    index="02"
    eyebrow="RESEARCH"
    title="Noita 研究"
    description="魔杖参数、炼金反应、法术交互。先定义变量，再记录现象，最后才下结论。"
    href="/research/wand-mechanics/"
    meta={`${entriesLabel(research)} / 实验笔记`}
    icon="flask"
  />
  <HomeCard
    index="03"
    eyebrow="REFERENCE"
    title="资料与工具"
    description="法术、材料与版本差异的索引。为后续的数据查询和交互工具预留位置。"
    href="/reference/spells/"
    meta={referenceMeta}
    icon="wand"
  />
</div>
