---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  description: string;
  href: string;
  meta: string;
  icon: 'book' | 'wand' | 'flask';
}

const { index, eyebrow, title, description, href, meta, icon } = Astro.props;
---

<a class="home-card" href={href}>
  <div class="home-card__top">
    <span class="home-card__index">{index}</span>
    <span class="home-card__icon" aria-hidden="true">
      {
        icon === 'book' && (
          <svg viewBox="0 0 32 32" fill="none">
            <path d="M5 7.5c4-1.5 7.4-.7 11 1.6v17c-3.6-2.3-7-3.1-11-1.6v-17Z" />
            <path d="M27 7.5c-4-1.5-7.4-.7-11 1.6v17c3.6-2.3 7-3.1 11-1.6v-17Z" />
            <path d="M9 11h3M9 15h3M20 11h3M20 15h3" />
          </svg>
        )
      }
      {
        icon === 'wand' && (
          <svg viewBox="0 0 32 32" fill="none">
            <path d="m6 26 15-15" />
            <path d="m19 8 2.3-4L24 8l4 2.3-4 2.3-2.7 4L19 12l-4-1.7L19 8Z" />
            <path d="M9 7v4M7 9h4M25 23v3M23.5 24.5h3" />
          </svg>
        )
      }
      {
        icon === 'flask' && (
          <svg viewBox="0 0 32 32" fill="none">
            <path d="M12 4h8M14 4v8L7 25a2.4 2.4 0 0 0 2.1 3.5h13.8A2.4 2.4 0 0 0 25 25L18 12V4" />
            <path d="M10 21h12M13 17.5c1.8 1.4 4.2 1.4 6 0" />
            <circle cx="14" cy="12.5" r="1" />
            <circle cx="20" cy="9.5" r=".8" />
          </svg>
        )
      }
    </span>
  </div>
  <div class="home-card__body">
    <p class="home-card__eyebrow">{eyebrow}</p>
    <h3>{title}</h3>
    <p class="home-card__desc">{description}</p>
  </div>
  <div class="home-card__foot">
    <span>{meta}</span>
    <span class="home-card__arrow" aria-hidden="true">↗</span>
  </div>
</a>

<style>
  @layer starlight.components {
    .home-card {
      --card-border: var(--line, rgba(216, 181, 111, 0.18));
      position: relative;
      display: flex;
      flex-direction: column;
      min-height: 22rem;
      padding: 1.3rem;
      overflow: hidden;
      color: inherit;
      text-decoration: none;
      background:
        linear-gradient(145deg, rgba(216, 181, 111, 0.055), transparent 42%),
        var(--card-bg, rgba(9, 12, 9, 0.72));
      border: 1px solid var(--card-border);
      transition: border-color 180ms ease, transform 180ms ease, background 180ms ease;
    }

    .home-card::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(115deg, transparent 30%, rgba(240, 215, 156, 0.07), transparent 62%);
      transform: translateX(-110%);
      transition: transform 500ms ease;
    }

    .home-card::after {
      content: '';
      position: absolute;
      inset: 0.42rem;
      pointer-events: none;
      border: 1px solid rgba(216, 181, 111, 0.06);
    }

    .home-card:hover {
      border-color: var(--line-strong, rgba(216, 181, 111, 0.38));
      background:
        linear-gradient(145deg, rgba(216, 181, 111, 0.09), transparent 45%),
        var(--card-bg-hover, rgba(12, 16, 11, 0.9));
      transform: translateY(-3px);
    }

    .home-card:hover::before {
      transform: translateX(110%);
    }

    .home-card__top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
    }

    .home-card__index {
      font-family: 'Silkscreen', 'Courier New', monospace;
      font-size: 0.62rem;
      letter-spacing: 0.14em;
      color: var(--sl-color-gray-3, #8d8675);
    }

    .home-card__icon {
      display: grid;
      place-items: center;
      width: 2.8rem;
      height: 2.8rem;
      border: 1px solid rgba(216, 181, 111, 0.24);
      color: var(--gold, #d8b56f);
      background: rgba(216, 181, 111, 0.045);
    }

    .home-card__icon :global(svg) {
      width: 1.55rem;
      height: 1.55rem;
      stroke: currentColor;
      stroke-width: 1.25;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .home-card__body {
      margin-top: auto;
      padding-top: 2.8rem;
    }

    .home-card__eyebrow {
      margin: 0 0 0.55rem;
      font-family: 'Silkscreen', 'Courier New', monospace;
      font-size: 0.58rem;
      letter-spacing: 0.16em;
      color: var(--gold-dim, #8a713f);
    }

    .home-card h3 {
      margin: 0;
      font-family: var(--font-display, serif);
      font-size: clamp(1.35rem, 2vw, 1.7rem);
      font-weight: 600;
      line-height: 1.3;
      letter-spacing: -0.01em;
      color: var(--sl-color-white, #f3ebda);
    }

    .home-card__desc {
      margin: 0.7rem 0 0;
      font-size: 0.9rem;
      line-height: 1.8;
      color: var(--sl-color-gray-2, #b9b09b);
    }

    .home-card__foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-top: 1.4rem;
      padding-top: 0.8rem;
      border-top: 1px solid var(--line, rgba(216, 181, 111, 0.18));
      font-family: 'Silkscreen', 'Courier New', monospace;
      font-size: 0.55rem;
      letter-spacing: 0.1em;
      color: var(--sl-color-gray-3, #8d8675);
    }

    .home-card__arrow {
      color: var(--gold, #d8b56f);
      font-size: 1rem;
      transition: transform 180ms ease;
    }

    .home-card:hover .home-card__arrow {
      transform: translate(2px, -2px);
    }

    @media (max-width: 50rem) {
      .home-card {
        min-height: 17rem;
      }
      .home-card__body {
        padding-top: 1.6rem;
      }
    }
  }
</style>
