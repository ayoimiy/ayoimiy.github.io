---
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title" aria-label="Noita 知识库首页">
  <svg class="site-mark" viewBox="0 0 64 64" fill="none" aria-hidden="true">
    <circle cx="32" cy="32" r="27" stroke="currentColor" stroke-opacity=".4"/>
    <circle cx="32" cy="32" r="21" stroke="currentColor" stroke-opacity=".2" stroke-dasharray="1.5 4"/>
    <path d="M12 32q20-17 40 0Q32 49 12 32Z" stroke="currentColor" stroke-width="1.4"/>
    <circle cx="32" cy="32" r="8" fill="currentColor" fill-opacity=".12" stroke="currentColor" stroke-width="1.2"/>
    <ellipse cx="32" cy="32" rx="2.4" ry="6" fill="var(--sl-color-bg)" stroke="currentColor"/>
    <path d="M32 2v7M32 55v7M2 32h7M55 32h7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
  </svg>
  <span class="site-type" aria-hidden="true">
    <span class="site-name">NOITA <em>ARCHIVE</em></span>
    <span class="site-sub">知识库 / 研究档案</span>
  </span>
</a>

<style>
  @layer starlight.components {
    .site-title {
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      color: var(--gold, #d8b56f);
      text-decoration: none;
      min-width: 0;
    }

    .site-mark {
      width: 2.35rem;
      height: 2.35rem;
      flex: none;
      filter: drop-shadow(0 0 8px rgba(216, 181, 111, 0.18));
      transition: filter 180ms ease, transform 180ms ease;
    }

    .site-title:hover .site-mark {
      filter: drop-shadow(0 0 12px rgba(216, 181, 111, 0.45));
      transform: rotate(8deg);
    }

    .site-type {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      line-height: 1;
      min-width: 0;
    }

    .site-name {
      font-family: 'Silkscreen', 'Courier New', monospace;
      font-size: 0.95rem;
      letter-spacing: 0.08em;
      color: var(--gold-bright, #f0d79c);
      white-space: nowrap;
    }

    .site-name em {
      font-style: normal;
      color: var(--sl-color-gray-2, #b9b09b);
    }

    .site-sub {
      font-family: var(--sl-font, sans-serif);
      font-size: 0.62rem;
      letter-spacing: 0.18em;
      color: var(--sl-color-gray-3, #8d8675);
      white-space: nowrap;
    }

    @media (max-width: 30rem) {
      .site-title {
        gap: 0.5rem;
      }
      .site-mark {
        width: 2rem;
        height: 2rem;
      }
      .site-name {
        font-size: 0.8rem;
      }
      .site-sub {
        display: none;
      }
    }
  }
</style>
