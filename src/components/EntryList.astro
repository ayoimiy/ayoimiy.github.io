---
interface Entry {
  date: string;
  title: string;
  description: string;
  href: string;
  tag: string;
}

interface Props {
  entries: Entry[];
}

const { entries } = Astro.props;
---

<ol class="entry-list">
  {
    entries.map((entry, index) => (
      <li class="entry-list__item">
        <a href={entry.href} class="entry-list__link">
          <span class="entry-list__number">{String(index + 1).padStart(2, '0')}</span>
          <span class="entry-list__main">
            <span class="entry-list__kicker">
              <span>{entry.date}</span>
              <span class="entry-list__tag">{entry.tag}</span>
            </span>
            <span class="entry-list__title">{entry.title}</span>
            <span class="entry-list__desc">{entry.description}</span>
          </span>
          <span class="entry-list__arrow" aria-hidden="true">→</span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  @layer starlight.components {
    .entry-list {
      list-style: none;
      padding: 0;
      margin: 0;
      border-top: 1px solid var(--line, rgba(216, 181, 111, 0.18));
    }

    .entry-list__item {
      border-bottom: 1px solid var(--line, rgba(216, 181, 111, 0.18));
    }

    .entry-list__link {
      display: grid;
      grid-template-columns: 2.6rem minmax(0, 1fr) auto;
      gap: 1rem;
      align-items: start;
      padding: 1.15rem 0.25rem 1.15rem 0;
      color: inherit;
      text-decoration: none;
      transition: background 160ms ease, padding 160ms ease;
    }

    .entry-list__link:hover {
      background: rgba(216, 181, 111, 0.035);
      padding-left: 0.5rem;
    }

    .entry-list__number {
      padding-top: 0.2rem;
      font-family: 'Silkscreen', 'Courier New', monospace;
      font-size: 0.58rem;
      letter-spacing: 0.08em;
      color: var(--gold-dim, #8a713f);
    }

    .entry-list__main {
      display: flex;
      flex-direction: column;
      gap: 0.28rem;
      min-width: 0;
    }

    .entry-list__kicker {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      font-family: 'Silkscreen', 'Courier New', monospace;
      font-size: 0.56rem;
      letter-spacing: 0.08em;
      color: var(--sl-color-gray-3, #8d8675);
    }

    .entry-list__tag {
      color: var(--gold-dim, #8a713f);
    }

    .entry-list__title {
      font-family: var(--font-display, serif);
      font-size: 1.18rem;
      font-weight: 600;
      line-height: 1.4;
      color: var(--sl-color-white, #f3ebda);
      transition: color 160ms ease;
    }

    .entry-list__link:hover .entry-list__title {
      color: var(--gold-bright, #f0d79c);
    }

    .entry-list__desc {
      font-size: 0.86rem;
      line-height: 1.75;
      color: var(--sl-color-gray-2, #b9b09b);
    }

    .entry-list__arrow {
      padding-top: 1.5rem;
      color: var(--gold-dim, #8a713f);
      transition: transform 160ms ease, color 160ms ease;
    }

    .entry-list__link:hover .entry-list__arrow {
      color: var(--gold-bright, #f0d79c);
      transform: translateX(3px);
    }

    @media (max-width: 40rem) {
      .entry-list__link {
        grid-template-columns: 1.6rem minmax(0, 1fr);
      }
      .entry-list__arrow {
        display: none;
      }
      .entry-list__desc {
        font-size: 0.82rem;
      }
    }
  }
</style>
